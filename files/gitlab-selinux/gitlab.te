module gitlab 1.2.0;

############################
# External policy components
############################
require {
    type http_cache_port_t;
    type httpd_t;
    type init_tmp_t;
    type ssh_keygen_t;
    type sshd_t;
    type unconfined_service_t;
    type var_log_t;

    attribute file_type;

    class dir { search getattr read open };
    class file { open read getattr append };
    class sock_file { write read };
    class tcp_socket name_connect;
    class unix_stream_socket connectto;
}

################################
# GitLab policy type definitions
################################
type gitlab_shell_t;

typeattribute gitlab_shell_t file_type;

#####################
# Access Vector Rules
#####################
allow ssh_keygen_t init_tmp_t:file open;

allow sshd_t unconfined_service_t:unix_stream_socket connectto;
allow sshd_t http_cache_port_t:tcp_socket name_connect;
allow sshd_t var_log_t:file { open append };
allow sshd_t gitlab_shell_t:file { read open getattr };
allow sshd_t gitlab_shell_t:sock_file write;

allow httpd_t gitlab_shell_t:sock_file { read write };

# sshd_session_t: per-session binary introduced in OpenSSH 9.8 (RHEL 10 / AlmaLinux 10).
# Without these rules, git-over-SSH fails with SELinux Enforcing because sshd-session
# cannot read the gitlab_shell_t-labelled authorized_keys file. The sock_file and
# var_log_t rules mirror the sshd_t grants and cover fast SSH key lookup.
# connectto and name_connect cover AuthorizedKeysCommand via workhorse socket / TCP.
# See: https://gitlab.com/gitlab-org/omnibus-gitlab/-/issues/10048
optional {
    require {
        type sshd_session_t;
    }
    allow sshd_session_t gitlab_shell_t:dir { search getattr };
    allow sshd_session_t gitlab_shell_t:file { getattr open read };
    allow sshd_session_t gitlab_shell_t:sock_file write;
    allow sshd_session_t unconfined_service_t:unix_stream_socket connectto;
    allow sshd_session_t http_cache_port_t:tcp_socket name_connect;
    allow sshd_session_t var_log_t:file { open append };
}

# sshd_auth_t: authentication-phase domain introduced in OpenSSH 10.0 / Fedora 43.
optional {
    require {
        type sshd_auth_t;
    }
    allow sshd_auth_t gitlab_shell_t:dir { search getattr };
    allow sshd_auth_t gitlab_shell_t:file { getattr open read };
    allow sshd_auth_t gitlab_shell_t:sock_file write;
    allow sshd_auth_t unconfined_service_t:unix_stream_socket connectto;
    allow sshd_auth_t http_cache_port_t:tcp_socket name_connect;
    allow sshd_auth_t var_log_t:file { open append };
}
